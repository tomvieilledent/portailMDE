# Production (portail-mde.vlldnt.fr) : copier vers /opt/vlldnt/config/portail-mde.env (chmod 600).
POSTGRES_USER=portail
POSTGRES_PASSWORD=
POSTGRES_DB=portail
# 32 caractères minimum
JWT_SECRET=
FRONTEND_URL=https://portail-mde.vlldnt.fr
# Port loopback du conteneur web (aligné sur projects.yml)
WEB_PORT=8087
MAIL_BACKEND=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=portailMDE <no-reply@vlldnt.fr>
