# Modèle de /opt/vlldnt/config/mde.env (chmod 600, hors Git) pour le déploiement sur vlldnt.fr.
POSTGRES_USER=portail
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portail
JWT_SECRET=change-me-with-at-least-32-random-characters
FRONTEND_URL=https://mde.vlldnt.fr
CORS_ORIGINS=["https://mde.vlldnt.fr"]
MAIL_BACKEND=smtp
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_FROM=portailMDE <no-reply@vlldnt.fr>
